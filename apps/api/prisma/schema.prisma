generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  ACTIVE
  PHASE_OUT
  DISCONTINUED
  UNKNOWN
}

model Product {
  id                    String        @id @default(uuid())
  sku                   String        @unique
  name                  String?
  chemicalName          String?
  function              String?
  applicationArea       String?
  region                String?
  certifications        String[]
  status                ProductStatus
  launchYear            Int?
  description           String?
  presentInLatestImport Boolean       @default(true)
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)
  lastImportedAt        DateTime      @db.Timestamptz(3)
}
